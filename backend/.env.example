PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/mishnex
# Comma-separated allowed origins; do not use * in production
ALLOWED_ORIGINS=https://mishnextechnologies.com,https://www.mishnextechnologies.com
NODE_ENV=development

# Required before Owner Login can work (Render environment variables)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
OWNER_USER_ID=owner-auth-user-uuid

# Staff and workflow gates: enable only on isolated staging after configuration.
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
STAFF_MANAGEMENT_ENABLED=false
STAFF_CRM_ENABLED=false
LEAD_WORKFLOW_ENABLED=false
CLIENT_MANAGEMENT_ENABLED=false
PAYMENT_REVIEW_ENABLED=false
# Production DB connections verify TLS; provide the database CA if required.
DATABASE_CA_CERT=
OWNER_EMAIL=owner@example.com

# Website enquiry notifications: configure these privately on Render.
# Missing SMTP credentials leave enquiries safely queued; delivery is not claimed.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ENQUIRY_EMAIL_TO=info@mishnex.com

# Optional lead integrations. Set secrets only in the hosting environment.
# Meta Page must subscribe to leadgen. Instagram lead ads use the linked Page.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_PAGE_IDS=
# Choose a currently supported Graph API version in your Meta app dashboard.
META_GRAPH_API_VERSION=
# JSON object: source slug -> random secret (minimum 32 characters)
LEAD_SOURCE_SECRETS={}
